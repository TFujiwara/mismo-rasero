# Copia a .env y ajusta. Los imports de Python leen estas variables vía pydantic-settings.
DATABASE_URL=postgresql+psycopg://blueprint:blueprint@localhost:5432/blueprint
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Scrapers — cabecera obligatoria para no pisar a los servicios oficiales
USER_AGENT=blueprint-transparencia/0.1 (contacto: pendiente@example.org)

# DIR3 — la URL de descarga masiva se movió de la documentada en el blueprint §01.
# Pon aquí la URL del fichero CSV/XLSX de unidades DIR3 cuando la localices en
# administracion.gob.es (Directorio Común). Sin ella, Dir3Adapter no ingesta.
DIR3_URL=

# EUR-Lex devuelve 202 (soft-block) a IPs de datacenter desde algunas ubicaciones.
# Si el RSS responde, no hace falta tocar nada. Si no, proxy aquí.
EURLEX_PROXY=
